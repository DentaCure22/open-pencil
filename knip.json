{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["desktop/target/**", "**/dist/**", "**/node_modules/**"],
  "ignoreWorkspaces": ["packages/demos"],
  "ignoreUnresolved": [
    "~icons/*",
    "/packages/core/src/kiwi/index.ts",
    "/packages/core/src/text/fonts.ts",
    "/packages/scene-graph/src/object-graph.ts",
    "/src/app/code-object/compiler.tsx",
    "/src/app/code-object/model.ts",
    "/src/app/context-comment/state.ts",
    "/src/app/editor/fonts/index.ts",
    "/src/app/editor/viewport-insets.ts",
    "/src/app/narrated-trace/gesture.ts",
    "/src/app/narrated-trace/history.ts",
    "/src/app/narrated-trace/index.ts",
    "/src/app/narrated-trace/panel.ts",
    "/src/app/narrated-trace/query.ts",
    "/src/app/narrated-trace/scope.ts",
    "/src/app/narrated-trace/state.ts",
    "/src/app/smylr-live-inspector/outer-html.ts",
    "/src/app/smylr-live-inspector/session.ts",
    "/src/app/workspace-document/identity.ts",
    "#core/*"
  ],
  "ignoreBinaries": ["board", "figma-use", "identify", "magick", "open", "osascript"],
  "workspaces": {
    ".": {
      "ignoreDependencies": [
        "@arethetypeswrong/cli",
        "@feature-sliced/steiger-plugin",
        "@iconify-json/lucide",
        "@types/opentype.js",
        "mitata",
        "opentype.js"
      ]
    }
  }
}
