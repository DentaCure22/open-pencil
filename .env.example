VITE_OPENPENCIL_CLOUD_ENABLED=false
VITE_OPENPENCIL_SUPABASE_URL=https://your-openpencil-project.supabase.co
VITE_OPENPENCIL_SUPABASE_ANON_KEY=your-openpencil-anon-key

# Optional local-first authority. Set this to the existing workspace selected
# for an explicit one-time seed; do not choose a workspace by connection order.
OPENPENCIL_LOCAL_WORKSPACE_ID=
# Defaults to ~/.openpencil/local-workspace-authority-v1
OPENPENCIL_LOCAL_WORKSPACE_ROOT=

# Optional local launcher for the Smylr trusted-web-app Code Object.
# The Board stores the "npm run dev" label; execution stays allowlisted here.
OPENPENCIL_SMYLR_APP_ROOT=
