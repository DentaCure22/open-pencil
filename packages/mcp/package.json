{
  "name": "@open-pencil/mcp",
  "version": "0.13.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-pencil/open-pencil.git",
    "directory": "packages/mcp"
  },
  "bin": {
    "openpencil-mcp": "./dist/stdio.mjs",
    "openpencil-mcp-http": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/server.mjs",
  "imports": {
    "#mcp/*": {
      "types": "./src/*.ts",
      "bun": "./src/*.ts",
      "default": "./dist/*.mjs"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.mts",
      "import": "./dist/server.mjs",
      "default": "./dist/server.mjs"
    },
    "./stdio": {
      "types": "./dist/stdio.d.mts",
      "import": "./dist/stdio.mjs",
      "default": "./dist/stdio.mjs"
    },
    "./local-workspace-authority": {
      "types": "./dist/local-workspace-authority.d.mts",
      "bun": "./src/local-workspace-authority.ts",
      "import": "./dist/local-workspace-authority.mjs",
      "default": "./dist/local-workspace-authority.mjs"
    },
    "./usage-ledger-schema": {
      "types": "./dist/usage-ledger-schema.d.mts",
      "bun": "./src/usage-ledger-schema.ts",
      "import": "./dist/usage-ledger-schema.mjs",
      "default": "./dist/usage-ledger-schema.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bunx tsdown --config tsdown.config.ts",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@open-pencil/core": "workspace:*",
    "@open-pencil/scene-graph": "workspace:*",
    "hono": "^4.12.5",
    "mermaid": "11.16.0",
    "package-manager-detector": "^1.6.0",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.3.2",
    "@types/ws": "^8.18.1"
  }
}
